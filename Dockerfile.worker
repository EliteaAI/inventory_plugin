# ================================================================
# Inventory Worker - K8s ingestion Job runner
#
# Dedicated worker image: Python deps + plugin code are baked in.
# Runtime pods use emptyDir and synchronize job I/O/results through the
# ELITEA artifact API, not a shared PVC.
#
# Build CPU-only for Minikube (linux/amd64):
#   docker buildx build --platform linux/amd64 \
#       --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu \
#       -f Dockerfile.worker -t inventory-worker:local-cpu --load .
# ================================================================

FROM python:3.12-slim-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libcairo2-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUSERBASE=/opt/inventory
ENV PATH="/opt/inventory/bin:${PATH}"

COPY requirements.txt /tmp/requirements.txt

ARG TORCH_INDEX_URL=""

RUN set -ex; \
    if [ -n "${TORCH_INDEX_URL}" ]; then \
        pip install --user --no-cache-dir -U \
            --retries 3 --timeout 600 \
            --extra-index-url "${TORCH_INDEX_URL}" \
            -r /tmp/requirements.txt; \
    else \
        pip install --user --no-cache-dir -U \
            --retries 3 --timeout 600 \
            -r /tmp/requirements.txt; \
    fi \
    && rm /tmp/requirements.txt

FROM python:3.12-slim-bookworm

LABEL maintainer="EliteaAI" \
      description="Inventory worker - ingestion Job runner" \
      base="python:3.12-slim-bookworm"

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libcairo2 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/inventory /app \
    && chown -R 33:33 /opt/inventory /app

COPY --from=builder --chown=33:33 /opt/inventory /opt/inventory
COPY --chown=33:33 . /app/inventory_plugin

RUN mkdir -p /app/plugins \
    && ln -s /app/inventory_plugin /app/plugins/inventory_plugin \
    && touch /app/plugins/__init__.py \
    && chown -R 33:33 /app/plugins \
    && echo "prebaked $(date -u +%Y-%m-%dT%H:%M:%SZ) python:3.12-slim-bookworm" \
        > /opt/inventory/.prebaked

ENV PYTHONUSERBASE=/opt/inventory
ENV PATH="/opt/inventory/bin:${PATH}"

USER 33:33
WORKDIR /app