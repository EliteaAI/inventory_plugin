# Development server configuration
# Copy this file to .env and fill in your values

# Remote server for API proxying during development
VITE_DEV_SERVER=https://dev.elitea.ai

# Optional: Bearer token for authentication in dev mode
# VITE_DEV_TOKEN=your_bearer_token_here

# Default IDs for development (when not specified in URL)
# VITE_DEFAULT_PROJECT_ID=5
# VITE_DEFAULT_TOOLKIT_ID=42
